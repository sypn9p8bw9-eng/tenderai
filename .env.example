# Browser-safe Supabase project configuration. Obtain both values from the
# Supabase project's Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-project-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only credential used exclusively by the document processing worker.
# Never prefix this variable with NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
