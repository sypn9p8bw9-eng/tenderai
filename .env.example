# Browser-safe Supabase project configuration. Obtain both values from the
# Supabase project's Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-project-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only credentials used exclusively by trusted document/embedding workers.
# Never prefix these variables with NEXT_PUBLIC_ or expose them to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=your-openai-api-key

# The database vector contract is 1536 dimensions. The configured model must
# support requests at this dimension. Existing embeddings remain model-tagged.
EMBEDDING_MODEL=text-embedding-3-small
